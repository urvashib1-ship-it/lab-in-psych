        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="if ((((trials.thisTrialN + 1) % 60) === 0)) {&amp;#10;    continueRoutine = false;&amp;#10;    psychoJS.experiment.nextEntry();&amp;#10;    pauseLoop = true;&amp;#10;} else {&amp;#10;    pauseLoop = false;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# Check if this is the end of a 60-trial block&amp;#10;if (trials.thisTrialN + 1) % 60 == 0:&amp;#10;    # Pause after every 60th trial&amp;#10;    continueRoutine = False&amp;#10;    # Show the pause screen&amp;#10;    thisExp.nextEntry()  # end the current trial's data entry&amp;#10;    pauseLoop = True&amp;#10;else:&amp;#10;    pauseLoop = False&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
